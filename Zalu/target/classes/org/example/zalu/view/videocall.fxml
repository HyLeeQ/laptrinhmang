<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.zalu.controller.media.VideoCallController"
            prefHeight="600.0" prefWidth="900.0"
            style="-fx-background-color: #1a1a1a;">
    
    <!-- Top Bar - Call Info -->
    <top>
        <VBox spacing="10" style="-fx-background-color: #2d2d2d; -fx-padding: 15;">
            <Label fx:id="statusLabel" text="Kết nối..." 
                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Label fx:id="callDurationLabel" text="00:00:00" 
                   style="-fx-text-fill: #4CAF50; -fx-font-size: 14px;"/>
        </VBox>
    </top>
    
    <!-- Center - Video Display -->
    <center>
        <StackPane fx:id="videoContainer" style="-fx-background-color: #000000;">
            <!-- Remote Video (Full Screen) -->
            <ImageView fx:id="remoteVideoView" 
                      fitWidth="640" fitHeight="480"
                      preserveRatio="true"
                      style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 10, 0, 0, 0);"/>
            
            <!-- Local Video (Picture-in-Picture) -->
            <StackPane alignment="TOP_RIGHT" StackPane.alignment="TOP_RIGHT">
                <ImageView fx:id="localVideoView"
                          fitWidth="200" fitHeight="150"
                          preserveRatio="true"
                          style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.8), 15, 0, 0, 0);
                                 -fx-border-color: #4CAF50; -fx-border-width: 2px;">
                    <StackPane.margin>
                        <Insets top="20" right="20"/>
                    </StackPane.margin>
                </ImageView>
            </StackPane>
        </StackPane>
    </center>
    
    <!-- Bottom - Controls -->
    <bottom>
        <HBox alignment="CENTER" spacing="20" 
              style="-fx-background-color: #2d2d2d; -fx-padding: 20;">
            
            <!-- Mute Button -->
            <Button fx:id="muteButton" text="Tắt tiếng"
                   style="-fx-background-color: #424242; 
                          -fx-text-fill: white; 
                          -fx-font-size: 14px;
                          -fx-padding: 12 25;
                          -fx-background-radius: 50;
                          -fx-cursor: hand;"
                   onMouseEntered="#this.setStyle('-fx-background-color: #616161; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 25; -fx-background-radius: 50; -fx-cursor: hand;')"
                   onMouseExited="#this.setStyle('-fx-background-color: #424242; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 25; -fx-background-radius: 50; -fx-cursor: hand;')">
                <graphic>
                    <Label text="🔇" style="-fx-font-size: 18px;"/>
                </graphic>
            </Button>
            
            <!-- Video Toggle Button -->
            <Button fx:id="videoToggleButton" text="Tắt Video"
                   style="-fx-background-color: #424242; 
                          -fx-text-fill: white; 
                          -fx-font-size: 14px;
                          -fx-padding: 12 25;
                          -fx-background-radius: 50;
                          -fx-cursor: hand;"
                   onMouseEntered="#this.setStyle('-fx-background-color: #616161; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 25; -fx-background-radius: 50; -fx-cursor: hand;')"
                   onMouseExited="#this.setStyle('-fx-background-color: #424242; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 25; -fx-background-radius: 50; -fx-cursor: hand;')">
                <graphic>
                    <Label text="📹" style="-fx-font-size: 18px;"/>
                </graphic>
            </Button>
            
            <!-- End Call Button -->
            <Button fx:id="endCallButton" text="Kết thúc"
                   style="-fx-background-color: #f44336; 
                          -fx-text-fill: white; 
                          -fx-font-size: 14px;
                          -fx-font-weight: bold;
                          -fx-padding: 12 30;
                          -fx-background-radius: 50;
                          -fx-cursor: hand;"
                   onMouseEntered="#this.setStyle('-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 30; -fx-background-radius: 50; -fx-cursor: hand;')"
                   onMouseExited="#this.setStyle('-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 30; -fx-background-radius: 50; -fx-cursor: hand;')">
                <graphic>
                    <Label text="📞" style="-fx-font-size: 18px;"/>
                </graphic>
            </Button>
        </HBox>
    </bottom>
</BorderPane>
